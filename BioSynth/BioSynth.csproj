<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    BioSynth : application unique pour Windows, Linux et macOS.
    Serveur local ASP.NET Core + interface dans une fenêtre de navigateur.
    Lancer :  dotnet run   (une fenêtre s'ouvre sur http://localhost:5080)
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BioSynth</AssemblyName>
    <RootNamespace>BioSynth.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BioSynth.Core\BioSynth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
