                            </Grid>
                        </Border>
    
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem x:Name="TabEt" Header="◉ EYE TRACKING" Style="{StaticResource ConfigTab}">
