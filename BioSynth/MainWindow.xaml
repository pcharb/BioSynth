                                  Background="White" Foreground="Black"
                                  BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas" Height="28"
                                  SelectionChanged="CbEtOutputMode_Changed">
                            <ComboBoxItem Content="Fichier"    Tag="File"/>
                            <ComboBoxItem Content="TCP Stream" Tag="TCP"/>
                            <ComboBoxItem Content="UDP Stream" Tag="UDP" IsSelected="True"/>
                        </ComboBox>
    
                        <StackPanel x:Name="PanelEtFile" Visibility="Collapsed">
                            <TextBlock Text="FICHIER ET" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold" Margin="0,4,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtEtFilePath" Grid.Column="0"
                                         Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextPrimary}"
                                         BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas"
                                         Height="28" Padding="6,4" Text="eyetracking_data.csv"/>
                                <Button Grid.Column="1" Content="…" Click="BtnBrowseEt_Click"
                                        Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextPrimary}"
                                        BorderThickness="0" Margin="3,0,0,0" Height="28"/>
                            </Grid>
                        </StackPanel>
    
                        <StackPanel x:Name="PanelEtStream">
                            <TextBlock Text="HÔTE ET" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold" Margin="0,4,0,3"/>
                            <TextBox x:Name="TxtEtHost" Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextPrimary}"
                                     BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas"
                                     Height="28" Padding="6,4" Text="127.0.0.1" Margin="0,0,0,4"/>
                            <TextBlock Text="PORT ET" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
