                                        BorderThickness="0" FontSize="14"
                                        Visibility="Collapsed" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
    
                        <!-- Panel Génération ET (masqué en replay) -->
                        <StackPanel x:Name="PanelEtGenerate">
