                        </StackPanel>
    
                        <TextBlock Text="OPTIONS" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkFtHeadMove" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Consolas"
                                  FontSize="11" Content="Mouvement de tête" IsChecked="True" Margin="0,0,0,3"/>
                        <CheckBox x:Name="ChkFtMicro" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Consolas"
                                  FontSize="11" Content="Micro-expressions" IsChecked="True" Margin="0,0,0,3"/>
    
                        <TextBlock Text="DURÉE ÉTAT ÉMOTIONNEL (sec)" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,4,0,3"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SlFtEmoDur" Grid.Column="0"
                                    Minimum="1" Maximum="15" Value="4"
                                    ValueChanged="SlFtEmoDur_Changed"/>
                            <TextBlock x:Name="TxtFtEmoDurVal" Grid.Column="1"
                                       Text="4.0" Foreground="{DynamicResource Brush.AccentViolet}"
                                       FontFamily="Consolas" FontSize="11"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <TextBlock Text="BRUIT FT" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SlFtNoise" Grid.Column="0"
                                    Minimum="0" Maximum="1" Value="0.2"
                                    ValueChanged="SlFtNoise_Changed"/>
                            <TextBlock x:Name="TxtFtNoiseVal" Grid.Column="1"
                                       Text="0.20" Foreground="{DynamicResource Brush.AccentViolet}"
                                       FontFamily="Consolas" FontSize="11"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="12,12,12,12" MaxWidth="440" HorizontalAlignment="Stretch">
                        <!-- LSL Face Tracking -->
                        <Separator Background="{DynamicResource Brush.BgPurpleDeep}" Margin="0,6,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkLslFt" Grid.Column="0" Content="LSL FT"
                                      Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas" FontSize="9"
                                      IsChecked="False" VerticalAlignment="Center" Margin="0,0,6,0"
                                      Checked="ChkLslFt_Changed" Unchecked="ChkLslFt_Changed"/>
                            <TextBox x:Name="TxtLslNameFt" Grid.Column="1"
                                     Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextSecondary}"
                                     BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas" FontSize="9"
                                     Height="24" Padding="4,2" Text="BioSynth_Face"/>
                        </Grid>
    
                        <!-- Bouton Face Tracking -->
                        <Button x:Name="BtnFtStartStop" Content="▶  DÉMARRER FT"
                                Click="BtnFtStartStop_Click" Height="42"
                                FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                Background="{DynamicResource Brush.BgPurpleDeep}" Foreground="{DynamicResource Brush.AccentViolet}" BorderThickness="0"
                                Margin="0,0,0,4"/>
    
                        <!-- Statut FT -->
                        <Border Background="{DynamicResource Brush.BgPanel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="STATUT" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                               FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtFtStatus" Text="Prêt"
                                               Foreground="{DynamicResource Brush.AccentViolet}" FontFamily="Consolas" FontSize="10"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SAMPLES" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                               FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtFtSampleCount" Text="0"
                                               Foreground="{DynamicResource Brush.AccentViolet}" FontFamily="Consolas"
                                               FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MODE" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                               FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtFtModeLabel" Text="FACE"
                                               Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas"
                                               FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
    
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem x:Name="TabViz" Header="▤ VISUALISATION" Style="{StaticResource ConfigTab}">
            <Grid Background="{DynamicResource Brush.BgWindow}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- Barre du haut -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.BgPanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="OSCILLOSCOPE EEG" Foreground="{DynamicResource Brush.AccentGreen}"
                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtChannelInfo" Text="  8CH·256Hz"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="RecDotEeg" Width="7" Height="7"
                                     Fill="{DynamicResource Brush.AccentGreen}" Margin="0,0,4,0" Opacity="0"/>
                            <TextBlock x:Name="TxtRecLabel" Text="EEG IDLE"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Ellipse x:Name="RecDotEt" Width="7" Height="7"
                                     Fill="{DynamicResource Brush.AccentCyan}" Margin="0,0,4,0" Opacity="0"/>
                            <TextBlock x:Name="TxtEtRecLabel" Text="ET IDLE"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Ellipse x:Name="RecDotFt" Width="7" Height="7"
                                     Fill="{DynamicResource Brush.AccentViolet}" Margin="0,0,4,0" Opacity="0"/>
                            <TextBlock x:Name="TxtFtRecLabel" Text="FT IDLE"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Zone EEG oscilloscope + TopoMap + ET + FT -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Oscilloscope EEG -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.BgWindow}">
                        <ItemsControl x:Name="EEGPlotsPanel" Background="{DynamicResource Brush.BgWindow}"/>
                    </ScrollViewer>

                    <!-- Panneau Eye Tracking -->
                    <Border Grid.Column="1" Background="{DynamicResource Brush.BgHeader}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
                        <StackPanel>
                            <!-- Titre ET -->
                            <Border Background="{DynamicResource Brush.BgPanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <TextBlock Text="◉ EYE TRACKING" Foreground="{DynamicResource Brush.AccentCyan}"
                                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                            </Border>

                            <!-- Gaze Map -->
                            <Border Padding="8">
                                <StackPanel>
                                    <TextBlock Text="CARTE DU REGARD" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Background="{DynamicResource Brush.BgCanvas}" Height="160">
                                        <Canvas x:Name="GazeMapCanvas" Background="Transparent">
                                            <!-- Grille -->
                                            <Line X1="0" Y1="80" X2="400" Y2="80"
                                                  Stroke="{DynamicResource Brush.BgSectionDeep}" StrokeThickness="0.5"/>
                                            <Line X1="152" Y1="0" X2="152" Y2="160"
                                                  Stroke="{DynamicResource Brush.BgSectionDeep}" StrokeThickness="0.5"/>
                                            <!-- Point de regard (déplacé par code) -->
                                            <Ellipse x:Name="GazeDot" Width="12" Height="12"
                                                     Fill="{DynamicResource Brush.AccentCyan}" Opacity="0.9"/>
                                            <!-- Traîne (heatmap simplifiée) -->
                                            <Ellipse x:Name="GazeTrail1" Width="8" Height="8"
                                                     Fill="{DynamicResource Brush.AccentCyan}" Opacity="0.4"/>
                                            <Ellipse x:Name="GazeTrail2" Width="6" Height="6"
                                                     Fill="{DynamicResource Brush.AccentCyan}" Opacity="0.25"/>
                                            <Ellipse x:Name="GazeTrail3" Width="4" Height="4"
                                                     Fill="{DynamicResource Brush.AccentCyan}" Opacity="0.12"/>
                                        </Canvas>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Données numériques -->
                            <Border Padding="8,0,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="LblGazeX" Text="GAZE X" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                                   FontSize="9" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtGazeX" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentCyan}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                        <TextBlock x:Name="LblGazeY" Text="GAZE Y" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                                   FontSize="9" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="TxtGazeY" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentCyan}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="ÉVÉNEMENT" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                                   FontSize="9" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="TxtEtEventDetail" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentAmber}" FontFamily="Consolas"
                                                   FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="LblPupilL" Text="PUPILLE G (mm)" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtPupilL" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentViolet}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                        <TextBlock x:Name="LblPupilR" Text="PUPILLE D (mm)" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="TxtPupilR" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentViolet}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="VITESSE (°/s)" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="TxtEtVelocity" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentRed}" FontFamily="Consolas"
                                                   FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Graphiques pupille -->
                            <Border Padding="8,0,8,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtPupilTitle" Text="DIAMÈTRE PUPILLAIRE" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Background="{DynamicResource Brush.BgCanvas}" Height="80">
                                        <Canvas x:Name="PupilCanvas" Background="Transparent">
                                            <Polyline x:Name="PupilLineL"
                                                      Stroke="{DynamicResource Brush.AccentViolet}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"/>
                                            <Polyline x:Name="PupilLineR"
                                                      Stroke="{DynamicResource Brush.AccentPink}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Border>
                                    <!-- Légende -->
                                    <StackPanel x:Name="PupilLegend" Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.AccentViolet}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Gauche" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,0,12,0"/>
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.AccentPink}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Droite" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- Panneau Face Tracking -->
                    <Border Grid.Column="2" Background="{DynamicResource Brush.BgPurple}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
                        <StackPanel>
                            <!-- Titre FT -->
                            <Border Background="{DynamicResource Brush.BgPanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <TextBlock Text="◈ FACE TRACKING" Foreground="{DynamicResource Brush.AccentViolet}"
                                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                            </Border>

                            <!-- Visualisation visage (landmarks 2D) -->
                            <Border Padding="8">
                                <StackPanel>
                                    <TextBlock Text="LANDMARKS 68pts" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                                    <Border BorderBrush="{DynamicResource Brush.BgPurpleMid}" BorderThickness="1"
                                            Background="{DynamicResource Brush.BgCanvasPurple}" Height="160">
                                        <Canvas x:Name="FaceCanvas" Background="Transparent">
                                            <!-- Points générés dynamiquement par code -->
                                        </Canvas>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Pose tête -->
                            <Border Padding="8,0,8,6">
                                <StackPanel>
                                    <TextBlock Text="POSE TÊTE (6-DOF)" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PITCH" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8"/>
                                            <TextBlock x:Name="TxtFtPitch" Text="0.0°"
                                                       Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="YAW" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8" Margin="0,3,0,0"/>
                                            <TextBlock x:Name="TxtFtYaw" Text="0.0°"
                                                       Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ROLL" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8"/>
                                            <TextBlock x:Name="TxtFtRoll" Text="0.0°"
                                                       Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="PROF." Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8" Margin="0,3,0,0"/>
                                            <TextBlock x:Name="TxtFtZ" Text="650mm"
                                                       Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CONF." Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8"/>
                                            <TextBlock x:Name="TxtFtConf" Text="—"
                                                       Foreground="{DynamicResource Brush.AccentGreen}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="MICRO" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8" Margin="0,3,0,0"/>
                                            <TextBlock x:Name="TxtFtMicro" Text="—"
                                                       Foreground="{DynamicResource Brush.AccentAmber}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Émotion dominante + barres -->
                            <Border Padding="8,0,8,6">
                                <StackPanel>
                                    <TextBlock Text="ÉTAT ÉMOTIONNEL" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>

                                    <!-- Badge émotion dominante -->
                                    <Border x:Name="FtEmoBadge" Background="{DynamicResource Brush.BgPurpleAlt}"
                                            BorderBrush="{DynamicResource Brush.AccentViolet}" BorderThickness="1"
                                            Padding="8,4" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtFtEmoLabel" Text="NEUTRAL"
                                                       Foreground="{DynamicResource Brush.AccentViolet}" FontFamily="Consolas"
                                                       FontSize="13" FontWeight="Bold"/>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="AROUSAL" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="7"/>
                                                <TextBlock x:Name="TxtFtArousal" Text="—"
                                                           Foreground="{DynamicResource Brush.AccentAmber}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="VALENCE" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="7" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="TxtFtValence" Text="—"
                                                           Foreground="{DynamicResource Brush.AccentCyan}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Barres émotions -->
                                    <ItemsControl x:Name="FtEmoBarsPanel"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Barre du bas — Spectral EEG + stats ET + stats FT -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.BgPanelAlt}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bandes EEG -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BANDES DE FRÉQUENCE EEG" Foreground="{DynamicResource Brush.TextMuted}"
                                       FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="δ DELTA 0.5-4Hz" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,3"/>
                                    <ProgressBar x:Name="PbDelta" Height="10"
                                                 Background="{DynamicResource Brush.BgInset}" Foreground="{DynamicResource Brush.AccentViolet}"
                                                 BorderThickness="0" Maximum="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="θ THETA 4-8Hz" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,3"/>
                                    <ProgressBar x:Name="PbTheta" Height="10"
                                                 Background="{DynamicResource Brush.BgInset}" Foreground="{DynamicResource Brush.AccentCyan}"
                                                 BorderThickness="0" Maximum="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="α ALPHA 8-13Hz" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,3"/>
                                    <ProgressBar x:Name="PbAlpha" Height="10"
                                                 Background="{DynamicResource Brush.BgInset}" Foreground="{DynamicResource Brush.AccentGreen}"
                                                 BorderThickness="0" Maximum="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                    <TextBlock Text="β BETA 13-30Hz" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,3"/>
                                    <ProgressBar x:Name="PbBeta" Height="10"
                                                 Background="{DynamicResource Brush.BgInset}" Foreground="{DynamicResource Brush.AccentAmber}"
                                                 BorderThickness="0" Maximum="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="γ GAMMA 30-80Hz" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="Consolas" FontSize="9" Margin="0,0,0,3"/>
                                    <ProgressBar x:Name="PbGamma" Height="10"
                                                 Background="{DynamicResource Brush.BgInset}" Foreground="{DynamicResource Brush.AccentRed}"
                                                 BorderThickness="0" Maximum="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Stats combinées -->
                            <Border Background="{DynamicResource Brush.BgPanel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Margin="0,12,0,0" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="EEG" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtEegActiveLabel" Text="NON"
                                                   Foreground="{DynamicResource Brush.AccentRed}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ET" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtEtActiveLabel" Text="NON"
                                                   Foreground="{DynamicResource Brush.AccentRed}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="FT" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtFtActiveLabel" Text="NON"
                                                   Foreground="{DynamicResource Brush.AccentRed}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="REPLAY" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtReplayActiveLabel" Text="NON"
                                                   Foreground="{DynamicResource Brush.AccentRed}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="SYNC" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtSyncLabel" Text="—"
                                                   Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Stats Eye Tracking -->
                        <Border Grid.Column="1" Background="{DynamicResource Brush.BgHeader}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1,0,0,0" Padding="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STATISTIQUES EYE TRACKING" Foreground="{DynamicResource Brush.TextMuted}"
                                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FIXATIONS" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9"/>
                                        <TextBlock x:Name="TxtFixationCount" Text="0"
                                                   Foreground="{DynamicResource Brush.AccentGreen}" FontFamily="Consolas"
                                                   FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="SACCADES" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtSaccadeCount" Text="0"
                                                   Foreground="{DynamicResource Brush.AccentAmber}" FontFamily="Consolas"
                                                   FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CLIGNEMENTS" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9"/>
                                        <TextBlock x:Name="TxtBlinkCount" Text="0"
                                                   Foreground="{DynamicResource Brush.AccentPink}" FontFamily="Consolas"
                                                   FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="VIT. MOY (°/s)" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtAvgVelocity" Text="0"
                                                   Foreground="{DynamicResource Brush.AccentRed}" FontFamily="Consolas"
                                                   FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stats Face Tracking -->
                        <Border Grid.Column="2" Background="{DynamicResource Brush.BgPurple}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1,0,0,0" Padding="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STATISTIQUES FACE TRACKING" Foreground="{DynamicResource Brush.TextMuted}"
                                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ÉMOTION DOM." Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9"/>
                                        <TextBlock x:Name="TxtFtDomEmo" Text="NEUTRAL"
                                                   Foreground="{DynamicResource Brush.AccentViolet}" FontFamily="Consolas"
                                                   FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="TRANSITIONS" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtFtTransCount" Text="0"
                                                   Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas"
                                                   FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="AROUSAL MOY" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9"/>
                                        <TextBlock x:Name="TxtFtAvgArousal" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentAmber}" FontFamily="Consolas"
                                                   FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="VALENCE MOY" Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontFamily="Consolas" FontSize="9" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtFtAvgValence" Text="—"
                                                   Foreground="{DynamicResource Brush.AccentCyan}" FontFamily="Consolas"
                                                   FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
