                             SECTION EYE TRACKING
                        ═══════════════════════════════════ -->
                        <Border Background="{DynamicResource Brush.BgHeader}" BorderBrush="{DynamicResource Brush.AccentCyan}" BorderThickness="0,0,0,2"
