<Window x:Class="BioSynth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EEG + Eye Tracking Simulator"
        Height="960" Width="1600"
        Background="{DynamicResource Brush.BgWindow}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Onglets principaux : style sombre/clair suivant le thème -->
        <Style x:Key="ConfigTab" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.BgPanelAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,2"
                                Padding="18,8">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentCyan}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BgPanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête : titre + thème -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.BgPanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10,16,6">
            <StackPanel Width="360" HorizontalAlignment="Left">

            <!-- Titre -->
            <TextBlock Text="⬡ NEURO SIMULATOR" Foreground="{DynamicResource Brush.AccentGreen}"
                       FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
            <Grid Margin="0,2,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="EEG + Eye Tracking" Foreground="{DynamicResource Brush.TextMuted}"
                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                <!-- Thème : Auto (suit Windows) / Clair / Sombre -->
                <ComboBox x:Name="CbTheme" Grid.Column="1" Width="88" Height="22"
                          Background="White" Foreground="Black"
                          FontFamily="Consolas" FontSize="9"
                          ToolTip="Thème de l'interface"
                          SelectionChanged="CbTheme_Changed">
                    <ComboBoxItem Content="◐ Auto"   Tag="Auto" IsSelected="True"/>
                    <ComboBoxItem Content="☀ Clair"  Tag="Light"/>
                    <ComboBoxItem Content="☾ Sombre" Tag="Dark"/>
                </ComboBox>
            </Grid>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" Background="{DynamicResource Brush.BgWindow}"
                    BorderThickness="0" Padding="0" SelectionChanged="MainTabs_SelectionChanged">
        <TabItem x:Name="TabEeg" Header="⬡ EEG" Style="{StaticResource ConfigTab}">
            <Grid Background="{DynamicResource Brush.BgPanelAlt}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="480"/>
                    <ColumnDefinition Width="*" MaxWidth="480"/>
                    <ColumnDefinition Width="*" MaxWidth="480"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,12" MaxWidth="440" HorizontalAlignment="Stretch">
                        <!-- ══════════════════════════════
                             SECTION EEG
                        ═══════════════════════════════════ -->
                        <Border Background="{DynamicResource Brush.BgGreenHeader}" BorderBrush="{DynamicResource Brush.AccentGreen}" BorderThickness="0,0,0,2"
                                Padding="8,6" Margin="0,0,0,8">
                            <TextBlock Text="▶ EEG" Foreground="{DynamicResource Brush.AccentGreen}"
                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                        </Border>
    
                        <TextBlock Text="CANAUX" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CbChannels" Margin="0,0,0,8"
                                  Background="White" Foreground="Black"
                                  BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas" Height="28"
                                  SelectionChanged="CbChannels_SelectionChanged">
                            <ComboBoxItem Content="8 canaux"  Tag="8"  IsSelected="True"/>
                            <ComboBoxItem Content="16 canaux" Tag="16"/>
                            <ComboBoxItem Content="32 canaux" Tag="32"/>
                            <ComboBoxItem Content="64 canaux" Tag="64"/>
                        </ComboBox>
    
                        <TextBlock Text="TAUX D'ÉCHANTILLONNAGE (Hz)" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSampleRate" Margin="0,0,0,3"
                                 Background="White" Foreground="Black"
                                 BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas"
                                 Height="28" Padding="6,4" Text="256"
                                 PreviewTextInput="TxtSampleRate_PreviewTextInput"/>
                        <TextBlock Text="Typique : 128, 256, 512, 1024, 2048"
                                   Foreground="{DynamicResource Brush.TextDim}" FontFamily="Consolas" FontSize="9"
                                   Margin="0,0,0,8"/>
    
                        <TextBlock Text="MODE DE SORTIE EEG" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CbOutputMode" Margin="0,0,0,6"
                                  Background="White" Foreground="Black"
                                  BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas" Height="28"
                                  SelectionChanged="CbOutputMode_Changed">
                            <ComboBoxItem Content="Fichier"    Tag="File" IsSelected="True"/>
                            <ComboBoxItem Content="TCP Stream" Tag="TCP"/>
                            <ComboBoxItem Content="UDP Stream" Tag="UDP"/>
                        </ComboBox>
    
                        <StackPanel x:Name="PanelFile">
                            <TextBlock Text="FICHIER EEG" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold" Margin="0,4,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFilePath" Grid.Column="0"
                                         Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextPrimary}"
                                         BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas"
                                         Height="28" Padding="6,4" Text="eeg_data.csv"/>
                                <Button Grid.Column="1" Content="…" Click="BtnBrowse_Click"
                                        Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextPrimary}"
                                        BorderThickness="0" Margin="3,0,0,0" Height="28"/>
                            </Grid>
                            <TextBlock Text="FORMAT" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold" Margin="0,6,0,3"/>
                            <ComboBox x:Name="CbFormat" Margin="0,0,0,6"
                                      Background="White" Foreground="Black"
                                      BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas" Height="28">
                                <ComboBoxItem Content="CSV"            Tag="CSV"    IsSelected="True"/>
                                <ComboBoxItem Content="Binary Float32" Tag="Binary"/>
                                <ComboBoxItem Content="BDF"            Tag="BDF"/>
                            </ComboBox>
                        </StackPanel>
    
                        <StackPanel x:Name="PanelStream" Visibility="Collapsed">
                            <TextBlock Text="HÔTE EEG" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold" Margin="0,4,0,3"/>
                            <TextBox x:Name="TxtHost" Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextPrimary}"
                                     BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas"
                                     Height="28" Padding="6,4" Text="127.0.0.1" Margin="0,0,0,4"/>
                            <TextBlock Text="PORT EEG" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtPort" Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextPrimary}"
                                     BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas"
                                     Height="28" Padding="6,4" Text="9999" Margin="0,0,0,6"/>
                        </StackPanel>
    
                        <TextBlock Text="NIVEAU DE BRUIT EEG" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SlNoise" Grid.Column="0"
                                    Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlNoise_Changed"/>
                            <TextBlock x:Name="TxtNoiseVal" Grid.Column="1"
                                       Text="0.50" Foreground="{DynamicResource Brush.AccentGreen}"
                                       FontFamily="Consolas" FontSize="11"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <CheckBox x:Name="ChkArtifacts" Foreground="{DynamicResource Brush.TextPrimary}"
                                  FontFamily="Consolas" FontSize="11"
                                  Content="Générer artifacts EEG" IsChecked="True" Margin="0,0,0,8"/>
    
                        <TextBlock Text="CANAUX AFFICHÉS" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Slider x:Name="SlDisplayChannels" Minimum="1" Maximum="64" Value="4"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Margin="0,0,0,2" ValueChanged="SlDisplayChannels_Changed"/>
                        <TextBlock x:Name="TxtDisplayChannels" Text="4 canaux affichés"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,8"/>
    
                        <!-- ══════ LSL STREAM EEG ══════ -->
                        <Separator Background="{DynamicResource Brush.Border}" Margin="0,8,0,8"/>
                        <Border Background="{DynamicResource Brush.BgGreenSectionAlt}" BorderBrush="{DynamicResource Brush.AccentGreen}" BorderThickness="0,0,0,1"
                                Padding="6,4" Margin="0,0,0,6">
                            <TextBlock Text="⬡ LSL STREAM" Foreground="{DynamicResource Brush.AccentGreen}"
                                       FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkLslEeg" Grid.Column="0" Content="EEG"
                                      Foreground="{DynamicResource Brush.AccentGreen}" FontFamily="Consolas" FontSize="10"
                                      IsChecked="False" VerticalAlignment="Center" Margin="0,0,6,0"
                                      Checked="ChkLslEeg_Changed" Unchecked="ChkLslEeg_Changed"/>
                            <TextBox x:Name="TxtLslNameEeg" Grid.Column="1"
                                     Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextSecondary}"
                                     BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas" FontSize="9"
                                     Height="24" Padding="4,2"
                                     Text="BioSynth_EEG"/>
                        </Grid>
                        <TextBlock x:Name="TxtLslStatus" Text="○ LSL inactif"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8"
                                   Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="12,12,12,12" MaxWidth="440" HorizontalAlignment="Stretch">
                        <!-- ══════════════════════════════
                             ZONES CÉRÉBRALES + ÉTAT MENTAL
                        ═══════════════════════════════════ -->
                        <Border Background="{DynamicResource Brush.BgGreenSection}" BorderBrush="{DynamicResource Brush.AccentGreen}" BorderThickness="0,0,0,1"
                                Padding="8,5" Margin="0,0,0,8">
                            <TextBlock Text="⬡ ZONES CÉRÉBRALES" Foreground="{DynamicResource Brush.AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                        </Border>
    
                        <!-- Preset état mental -->
                        <TextBlock Text="ÉTAT MENTAL PRÉDÉFINI" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CbBrainPreset" Grid.Column="0"
                                      Background="White" Foreground="Black"
                                      BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas" Height="28">
                                <ComboBoxItem Content="Repos"           Tag="Repos"          IsSelected="True"/>
                                <ComboBoxItem Content="Concentration"   Tag="Concentration"/>
                                <ComboBoxItem Content="Méditation"      Tag="Méditation"/>
                                <ComboBoxItem Content="Éveil"           Tag="Éveil"/>
                                <ComboBoxItem Content="Sommeil léger"   Tag="Sommeil léger"/>
                                <ComboBoxItem Content="Sommeil profond" Tag="Sommeil profond"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Appliquer" Margin="4,0,0,0" Height="28"
                                    Click="BtnApplyPreset_Click"
                                    Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextPrimary}"
                                    BorderThickness="0" FontFamily="Consolas" FontSize="9"
                                    Cursor="Hand"/>
                        </Grid>
    
                        <!-- Sliders par zone -->
                        <TextBlock Text="ACTIVATION PAR RÉGION" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
    
                        <!-- Frontal -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Frontal" Foreground="{DynamicResource Brush.AccentSky}"
                                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                            <Slider x:Name="SlZoneFrontal" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlZone_Changed"/>
                            <TextBlock x:Name="TxtZoneFrontal" Grid.Column="2" Text=".50"
                                       Foreground="{DynamicResource Brush.AccentSky}" FontFamily="Consolas" FontSize="9"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <!-- Préfrontal -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Préfrontal" Foreground="{DynamicResource Brush.AccentSkyAlt}"
                                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                            <Slider x:Name="SlZonePrefrontal" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlZone_Changed"/>
                            <TextBlock x:Name="TxtZonePrefrontal" Grid.Column="2" Text=".50"
                                       Foreground="{DynamicResource Brush.AccentSkyAlt}" FontFamily="Consolas" FontSize="9"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <!-- Central -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Central" Foreground="{DynamicResource Brush.AccentGreen}"
                                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                            <Slider x:Name="SlZoneCentral" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlZone_Changed"/>
                            <TextBlock x:Name="TxtZoneCentral" Grid.Column="2" Text=".50"
                                       Foreground="{DynamicResource Brush.AccentGreen}" FontFamily="Consolas" FontSize="9"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <!-- Temporal -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Temporal" Foreground="{DynamicResource Brush.AccentOrange}"
                                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                            <Slider x:Name="SlZoneTemporal" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlZone_Changed"/>
                            <TextBlock x:Name="TxtZoneTemporal" Grid.Column="2" Text=".50"
                                       Foreground="{DynamicResource Brush.AccentOrange}" FontFamily="Consolas" FontSize="9"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <!-- Pariétal -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pariétal" Foreground="{DynamicResource Brush.AccentViolet}"
                                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                            <Slider x:Name="SlZoneParietal" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlZone_Changed"/>
                            <TextBlock x:Name="TxtZoneParietal" Grid.Column="2" Text=".50"
                                       Foreground="{DynamicResource Brush.AccentViolet}" FontFamily="Consolas" FontSize="9"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <!-- Occipital -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Occipital" Foreground="{DynamicResource Brush.AccentRed}"
                                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                            <Slider x:Name="SlZoneOccipital" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlZone_Changed"/>
                            <TextBlock x:Name="TxtZoneOccipital" Grid.Column="2" Text=".50"
                                       Foreground="{DynamicResource Brush.AccentRed}" FontFamily="Consolas" FontSize="9"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <!-- Fronto-Central -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FC" Foreground="{DynamicResource Brush.AccentLime}"
                                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                            <Slider x:Name="SlZoneFC" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="SlZone_Changed"/>
                            <TextBlock x:Name="TxtZoneFC" Grid.Column="2" Text=".50"
                                       Foreground="{DynamicResource Brush.AccentLime}" FontFamily="Consolas" FontSize="9"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
    
                        <!-- Bouton TopoMap 2D -->
                        <Button x:Name="BtnOpenTopoMap" Content="🗺  TOPOMAP 2D"
                                Click="BtnOpenTopoMap_Click" Height="36"
                                FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                Background="{DynamicResource Brush.BgBlueButton}" Foreground="{DynamicResource Brush.AccentCyan}" BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" Margin="0,0,0,4" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="12,12,12,12" MaxWidth="440" HorizontalAlignment="Stretch">
                        <!-- Mode source EEG : Génération ou Replay -->
                        <Border Background="{DynamicResource Brush.BgSection}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,0,0,1"
                                Padding="6,4" Margin="0,0,0,6">
                            <TextBlock Text="⏵ SOURCE DE DONNÉES" Foreground="{DynamicResource Brush.AccentCyan}"
                                       FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                        </Border>
    
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbGenerate" Grid.Column="0"
                                         Content="Générer" IsChecked="True"
                                         GroupName="EegSource"
                                         Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Consolas" FontSize="10"
                                         Checked="RbSource_Changed"/>
                            <RadioButton x:Name="RbReplay" Grid.Column="1"
                                         Content="Replay"
                                         GroupName="EegSource"
                                         Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Consolas" FontSize="10"
                                         Checked="RbSource_Changed"/>
                            <RadioButton x:Name="RbLslInlet" Grid.Column="2"
                                         Content="LSL IA"
                                         GroupName="EegSource"
                                         Foreground="{DynamicResource Brush.AccentLavender}" FontFamily="Consolas" FontSize="10"
                                         Checked="RbSource_Changed"/>
                        </Grid>
    
                        <!-- Panel Replay (visible si RbReplay sélectionné) -->
                        <StackPanel x:Name="PanelReplay" Visibility="Collapsed">
                            <TextBlock Text="FICHIER(S) (.csv, .xlsx, .vhdr, .bin)" Foreground="{DynamicResource Brush.TextMuted}"
                                       FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtReplayPath" Grid.Column="0"
                                         Background="{DynamicResource Brush.BgPanel}" Foreground="{DynamicResource Brush.TextPrimary}"
                                         BorderBrush="{DynamicResource Brush.Border}" FontFamily="Consolas"
                                         Height="28" Padding="6,4" Text=""/>
                                <Button Grid.Column="1" Content="…" Click="BtnBrowseReplay_Click"
                                        Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextPrimary}"
                                        BorderThickness="0" Margin="3,0,0,0" Height="28"/>
                            </Grid>
                            <TextBlock x:Name="TxtReplayInfo" Text="Sélectionner un ou plusieurs fichiers (Ctrl-clic)..."
                                       Foreground="{DynamicResource Brush.TextDim}" FontFamily="Consolas" FontSize="8"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VITESSE" Foreground="{DynamicResource Brush.TextMuted}"
                                           FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CbReplaySpeed" Grid.Column="1"
                                          Background="White" Foreground="Black"
                                          FontFamily="Consolas" Height="26"
                                          SelectionChanged="CbReplaySpeed_Changed">
                                    <ComboBoxItem Content="0.25×" Tag="0.25"/>
                                    <ComboBoxItem Content="0.5×"  Tag="0.5"/>
                                    <ComboBoxItem Content="1×"    Tag="1.0" IsSelected="True"/>
                                    <ComboBoxItem Content="2×"    Tag="2.0"/>
                                    <ComboBoxItem Content="4×"    Tag="4.0"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="ChkReplayLoop" Content="Boucler"
                                      Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Consolas" FontSize="10"
                                      IsChecked="False" Margin="0,0,0,4"/>
    
                            <!-- Barre de progression replay -->
                            <Grid Margin="0,0,0,2">
                                <ProgressBar x:Name="PbReplayProgress" Height="8"
                                             Background="{DynamicResource Brush.BgInset}" Foreground="{DynamicResource Brush.AccentCyan}"
                                             BorderThickness="0" Maximum="100" Value="0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtReplayProgress" Text="0%"
                                           Foreground="{DynamicResource Brush.TextMuted}" FontFamily="Consolas" FontSize="8"/>
                                <Button x:Name="BtnReplayPause" Grid.Column="1"
                                        Content="⏸" Click="BtnReplayPause_Click"
                                        Background="Transparent" Foreground="{DynamicResource Brush.AccentCyan}"
                                        BorderThickness="0" FontSize="14"
                                        Visibility="Collapsed" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
    
